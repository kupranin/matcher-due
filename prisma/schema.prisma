generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                  @id @default(cuid())
  authUserId            String?                 @unique @map("auth_user_id")
  email                 String                  @unique
  passwordHash          String                  @map("password_hash")
  role                  UserRole                @default(CANDIDATE)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  candidateProfile      CandidateProfile?
  company               Company?
  password_reset_tokens password_reset_tokens[]
  sessions              Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Company {
  id              String         @id @default(cuid())
  userId          String         @unique @map("user_id")
  name            String
  companyId       String         @map("company_id")
  contactEmail    String         @map("contact_email")
  contactPhone    String         @map("contact_phone")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  address         String?
  bio             String?
  employeeCount   String?        @map("employee_count")
  industry        String?
  linkedIn        String?
  website         String?
  available_slots Int            @default(10)
  logo            String?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancies       Vacancy[]
  purchases       purchases[]
  subscriptions   Subscription[]
}

model CandidateProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique @map("user_id")
  fullName           String           @map("full_name")
  phone              String?
  locationCityId     String           @map("location_city_id")
  locationDistrictId String?          @map("location_district_id")
  salaryMin          Int              @map("salary_min")
  willingToRelocate  Boolean          @default(false) @map("willing_to_relocate")
  experienceMonths   Int              @default(0) @map("experience_months")
  experienceText     String?          @map("experience_text")
  educationLevel     String           @default("High School") @map("education_level")
  workTypes          String[]         @map("work_types")
  photo              String?
  jobTitle           String?          @map("job_title")
  jobTitleEn         String?          @map("job_title_en")
  jobTitleKa         String?          @map("job_title_ka")
  jobRoleSlug        String?          @map("job_role_slug")
  sourceLocale       String?          @map("source_locale")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  availableToWork    Boolean          @default(true) @map("available_to_work")
  dateOfBirth        DateTime?        @map("date_of_birth") @db.Timestamp(6)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             CandidateSkill[]
  discards           Discard[]
  matches            Match[]
}

model CandidateSkill {
  id                 String           @id @default(cuid())
  candidateProfileId String           @map("candidate_profile_id")
  name               String
  nameEn             String?          @map("name_en")
  nameKa             String?          @map("name_ka")
  level              String
  createdAt          DateTime         @default(now()) @map("created_at")
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, name])
  @@map("candidate_skills")
}

model Vacancy {
  id                       String         @id @default(cuid())
  companyId                String         @map("company_id")
  title                    String
  titleEn                  String?        @map("title_en")
  titleKa                  String?        @map("title_ka")
  jobRoleSlug              String?        @map("job_role_slug")
  sourceLocale             String?        @map("source_locale")
  descriptionEn            String?        @map("description_en")
  descriptionKa            String?        @map("description_ka")
  locationCityId           String         @map("location_city_id")
  locationDistrictId       String?        @map("location_district_id")
  salaryMin                Int?           @map("salary_min")
  salaryMax                Int            @map("salary_max")
  workType                 String         @map("work_type")
  isRemote                 Boolean        @default(false) @map("is_remote")
  requiredExperienceMonths Int            @default(0) @map("required_experience_months")
  requiredEducationLevel   String         @default("High School") @map("required_education_level")
  description              String?
  photo                    String?
  status                   VacancyStatus  @default(PUBLISHED)
  contactName              String?        @map("contact_name")
  contactEmail             String?        @map("contact_email")
  contactPhone             String?        @map("contact_phone")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  company                  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  discards                 Discard[]
  matches                  Match[]
  skills                   VacancySkill[]
}

model VacancySkill {
  id         String   @id @default(cuid())
  vacancyId  String   @map("vacancy_id")
  name       String
  nameEn     String?  @map("name_en")
  nameKa     String?  @map("name_ka")
  level      String
  weight     Int      @default(3)
  isRequired Boolean  @default(true) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, name])
  @@map("vacancy_skills")
}

model Subscription {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  packageType    String   @map("package_type")
  pricePaid      Int      @map("price_paid")
  validUntil     DateTime @map("valid_until")
  vacanciesUsed  Int      @default(0) @map("vacancies_used")
  vacanciesTotal Int      @map("vacancies_total")
  createdAt      DateTime @default(now()) @map("created_at")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Job {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  category    String
  description String
  city        String
  type        String
  createdAt   DateTime   @default(now())
  skills      JobSkill[]
}

model JobSkill {
  id     String  @id @default(cuid())
  jobId  String  @map("job_id")
  name   String
  level  String?
  weight Int     @default(3)
  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_skills")
}

model GlobalSkill {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("global_skills")
}

model JobRoleTemplate {
  id          String              @id @default(uuid())
  slug        String
  locale      String
  title       String
  category    String
  description String
  skills      RoleSkillTemplate[]

  @@unique([slug, locale])
  @@map("job_role_templates")
}

model RoleSkillTemplate {
  id        String          @id @default(uuid())
  roleId    String          @map("role_id")
  skillName String          @map("skill_name")
  weight    Int
  role      JobRoleTemplate @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_skill_templates")
}

model Match {
  id                 String           @id @default(cuid())
  vacancyId          String           @map("vacancy_id")
  candidateProfileId String           @map("candidate_profile_id")
  employerLiked      Boolean          @default(false) @map("employer_liked")
  candidateLiked     Boolean          @default(false) @map("candidate_liked")
  createdAt          DateTime         @default(now()) @map("created_at")
  candidatePitch     String?          @map("candidate_pitch")
  matchScore         Int?             @map("match_score")
  matchedAt          DateTime?        @map("matched_at")
  chatMessages       ChatMessage[]
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  vacancy            Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@unique([vacancyId, candidateProfileId])
  @@unique([vacancyId, candidateProfileId], map: "matches_unique_pair")
  @@map("matches")
}

model Discard {
  id                 String           @id @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  vacancyId          String           @map("vacancy_id")
  candidateProfileId String           @map("candidate_profile_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "discards_candidate_profile_fk")
  vacancy            Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "discards_vacancy_fk")

  @@unique([vacancyId, candidateProfileId], map: "discards_unique_candidate_vacancy")
  @@index([candidateProfileId])
  @@index([vacancyId])
  @@map("discards")
}

model ChatMessage {
  id        String   @id @default(cuid())
  matchId   String   @map("match_id")
  sender    String
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model password_reset_tokens {
  id         String   @id
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model purchases {
  id           String   @id
  company_id   String
  package_type String
  amount_paid  Int
  slots_added  Int
  created_at   DateTime @default(now())
  Company      Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

enum UserRole {
  CANDIDATE
  EMPLOYER
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}
